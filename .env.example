# Variable names only — never commit real values.
APP_URL=
DATABASE_URL=

# Non-sensitive application identity (also set in app config)
STORE_SLUG=wba

# Login: secret from "npx auth secret"; Google OAuth client for this store only;
# ALLOWED_EMAILS = comma-separated team emails. Empty list = nobody can sign in.
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
ALLOWED_EMAILS=

# Shopify — leave empty until a dedicated app is configured later
SHOPIFY_STORE_DOMAIN=
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
SHOPIFY_ACCESS_TOKEN=
